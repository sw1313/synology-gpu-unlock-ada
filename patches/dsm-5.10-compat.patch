--- /dev/null
+++ b/kernel/gpu_unlock/pci_lock_compat.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef GPU_UNLOCK_PCI_LOCK_COMPAT_H
+#define GPU_UNLOCK_PCI_LOCK_COMPAT_H
+/* Match Linux 5.10 drivers/pci/pci.c's private pci_dev_lock()/unlock()
+ * using its exported primitives. Keep config access and driver binding locked.
+ */
+#ifndef __KERNEL__
+#ifndef WRITE_ONCE
+#define WRITE_ONCE(var, value) ((var) = (value))
+#endif
+/* Keep the upstream host-side PCI lock mocks usable. */
+#define gu_pci_dev_lock pci_dev_lock
+#define gu_pci_dev_unlock pci_dev_unlock
+#else
+static inline void gu_pci_dev_lock(struct pci_dev *pdev)
+{
+    pci_cfg_access_lock(pdev);
+    device_lock(&pdev->dev);
+}
+static inline void gu_pci_dev_unlock(struct pci_dev *pdev)
+{
+    device_unlock(&pdev->dev);
+    pci_cfg_access_unlock(pdev);
+}
+#endif /* __KERNEL__ */
+#endif
